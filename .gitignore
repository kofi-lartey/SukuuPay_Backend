.env
.env.*
!.env.example
.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / OS noise
.DS_Store
Thumbs.db
*.pid
*.seed

# Test + coverage output
coverage/
.nyc_output/

# Build output
dist/
build/
.cache/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Temp scratch used by local audits and probes
*.audit.mjs
audit-*.mjs

# Local database dumps — a copy of the live data, never committed
*-backup.json
